<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pet Boarding | FurryTales</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    /* Boarding page palette and layout stay consistent with the shared FurryTales navigation. */
    :root {
      --boarding-yellow: #F8E7A2;
      --boarding-beige: #F7F1E5;
      --boarding-sand: #E8D5B7;
      --boarding-brown: #79502E;
      --boarding-dark: #49321F;
    }

    body {
      min-height: 100vh;
      background: var(--boarding-beige);
      color: var(--boarding-dark);
      font-family: "Trebuchet MS", Arial, sans-serif;
    }

    .boarding-main {
      width: min(100% - 2rem, 1120px);
      margin: 0 auto;
      padding: 0.6rem 0 1.5rem;
    }

    .boarding-hero {
      padding: 0.35rem 0 0.85rem;
      text-align: center;
    }

    .boarding-title-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
    }

    .hero-paw {
      width: clamp(2.2rem, 5vw, 3.2rem);
      height: clamp(2.2rem, 5vw, 3.2rem);
      flex: 0 0 auto;
      color: #966542;
    }

    .hero-spark {
      width: 1.5rem;
      height: 2.5rem;
      flex: 0 0 auto;
      color: #F1C64C;
    }

    .boarding-hero h1 {
      margin: 0;
      color: var(--boarding-dark);
      font-size: clamp(2rem, 5vw, 2.8rem);
      font-weight: 800;
      line-height: 1.15;
    }

    .boarding-subtitle {
      margin: 0.2rem 0 0.25rem;
      color: var(--boarding-dark);
      font-size: clamp(1.05rem, 2.5vw, 1.35rem);
    }

    .boarding-intro {
      margin: 0;
      color: #66513D;
      font-size: clamp(0.95rem, 2vw, 1.05rem);
    }

    .room-grid {
      margin-bottom: 0.85rem;
    }

    .room-card {
      display: flex;
      min-height: 246px;
      height: 100%;
      align-items: center;
      gap: 1.2rem;
      padding: 0.9rem 1.15rem;
      border: 1px solid rgb(121 80 46 / 6%);
      border-radius: 2.35rem;
      background: #fff;
      box-shadow: 0 0.65rem 1.6rem rgb(73 50 31 / 7%);
      transition: transform 180ms ease, box-shadow 180ms ease;
    }

    .room-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 0.9rem 1.8rem rgb(73 50 31 / 12%);
    }

    .room-photo {
      width: clamp(170px, 18vw, 220px);
      height: clamp(170px, 18vw, 220px);
      flex: 0 0 auto;
      overflow: hidden;
      border-radius: 50%;
      background: var(--boarding-beige);
    }

    .room-photo img {
      display: block;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      transform: scale(1.4);
    }

    .room-details {
      min-width: 0;
      flex: 1 1 auto;
    }

    .room-details h2 {
      margin: 0 0 0.55rem;
      color: var(--boarding-brown);
      font-size: clamp(1.5rem, 2.5vw, 1.8rem);
      font-weight: 800;
    }

    .room-dimension,
    .room-area,
    .room-size {
      margin: 0.12rem 0;
      color: #49321F;
      font-size: 1.02rem;
    }

    .room-divider {
      width: 100%;
      margin: 0.55rem 0 0.45rem;
      border: 0;
      border-top: 1px solid var(--boarding-sand);
      opacity: 1;
    }

    .room-suitable {
      margin: 0;
      color: var(--boarding-dark);
      font-weight: 800;
    }

    .room-size {
      margin-bottom: 0.6rem;
    }

    .room-price {
      display: inline-flex;
      align-items: baseline;
      gap: 0.35rem;
      padding: 0.45rem 0.9rem;
      border-radius: 999px;
      background: var(--boarding-yellow);
      color: var(--boarding-dark);
      white-space: nowrap;
    }

    .room-price strong {
      font-size: 1.35rem;
      font-weight: 800;
    }

    .offers-panel {
      margin-top: 0.8rem;
      padding: 0.4rem 1rem 0.7rem;
      border-radius: 2rem;
      background: rgb(255 255 255 / 45%);
    }

    .offers-heading-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.1rem;
      margin-bottom: 0.25rem;
    }

    .offers-heading-row::before,
    .offers-heading-row::after {
      width: min(23%, 250px);
      height: 1px;
      background: #9B775A;
      content: "";
    }

    .offers-heading {
      margin: 0;
      color: var(--boarding-dark);
      font-size: clamp(1.55rem, 3vw, 1.9rem);
      font-weight: 800;
      white-space: nowrap;
    }

    .offers-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .offer-item {
      display: flex;
      min-height: 78px;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.2rem;
      padding: 0.45rem 0.35rem;
      text-align: center;
    }

    .offer-item:not(:nth-child(4n)) {
      border-right: 1px solid var(--boarding-sand);
    }

    .offer-item:nth-child(-n+4) {
      border-bottom: 1px solid var(--boarding-sand);
    }

    .offer-item h3 {
      margin: 0;
      color: #49321F;
      font-size: clamp(0.82rem, 1.5vw, 0.98rem);
      font-weight: 500;
    }

    .offer-icon {
      display: block;
      width: 2.65rem;
      height: 2.65rem;
    }

    .offer-icon svg {
      width: 100%;
      height: 100%;
    }

    /* Reservation form is not implemented yet, so the finished CTA remains safely disabled. */
    .booking-banner {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      margin-top: 0.85rem;
      padding: 0.8rem 1.55rem;
      border-radius: 1.35rem;
      background: var(--boarding-yellow);
    }

    .booking-paw {
      display: grid;
      width: 5.2rem;
      min-width: 5.2rem;
      height: 4.5rem;
      padding-right: 1.1rem;
      place-items: center;
      border-right: 1px solid #A8794E;
      color: #8A5730;
    }

    .booking-paw svg {
      width: 3.9rem;
      height: 3.9rem;
    }

    .booking-copy {
      min-width: 0;
      flex: 1 1 auto;
    }

    .booking-copy h2 {
      margin: 0 0 0.2rem;
      color: var(--boarding-dark);
      font-size: clamp(1.2rem, 2.5vw, 1.55rem);
      font-weight: 800;
    }

    .booking-copy p {
      margin: 0;
      color: #49321F;
      line-height: 1.45;
    }

    .booking-button {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      padding: 0.72rem 1.2rem;
      border: 0;
      border-radius: 999px;
      background: var(--boarding-brown);
      color: #fff;
      font-weight: 700;
      text-decoration: none;
      transition: background-color 160ms ease, transform 160ms ease;
    }

    .booking-button:hover,
    .booking-button:focus-visible {
      transform: translateY(-2px);
      background: var(--boarding-dark);
      color: #fff;
    }

    @media (max-width: 991.98px) {
      .room-card {
        gap: 0.9rem;
        padding: 0.85rem;
        border-radius: 2rem;
      }

      .room-photo {
        width: clamp(145px, 22vw, 190px);
        height: clamp(145px, 22vw, 190px);
      }

      .room-price {
        gap: 0.2rem;
        padding-right: 0.65rem;
        padding-left: 0.65rem;
      }

      .room-price strong {
        font-size: 1.2rem;
      }

      .booking-banner {
        flex-wrap: wrap;
      }
    }

    @media (max-width: 767.98px) {
      .boarding-main {
        width: min(100% - 1.25rem, 600px);
      }

      .boarding-hero {
        padding-top: 0.8rem;
      }

      .hero-spark {
        display: none;
      }

      .room-card {
        min-height: 0;
      }

      .offers-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .offer-item:not(:nth-child(2n)) {
        border-right: 1px solid var(--boarding-sand);
      }

      .offer-item:nth-child(2n) {
        border-right: 0;
      }

      .offer-item:nth-child(-n+6) {
        border-bottom: 1px solid var(--boarding-sand);
      }

      .offer-item:nth-child(n+5) {
        border-bottom: 0;
      }

      .booking-paw {
        width: 4rem;
        min-width: 4rem;
        padding-right: 0.7rem;
      }

      .booking-paw svg {
        width: 3rem;
        height: 3rem;
      }
    }

    @media (max-width: 575.98px) {
      .boarding-main {
        width: min(100% - 1rem, 440px);
      }

      .boarding-title-row {
        gap: 0.35rem;
      }

      .hero-paw {
        width: 2rem;
        height: 2rem;
      }

      .room-card {
        flex-direction: column;
        align-items: stretch;
        gap: 0.8rem;
        padding: 1rem;
      }

      .room-photo {
        width: 190px;
        height: 190px;
        align-self: center;
      }

      .room-details h2 {
        text-align: center;
      }

      .offers-panel {
        padding-right: 0.55rem;
        padding-left: 0.55rem;
      }

      .offers-heading-row {
        gap: 0.55rem;
      }

      .offers-heading-row::before,
      .offers-heading-row::after {
        width: 15%;
      }

      .offers-heading {
        font-size: 1.45rem;
      }

      .offer-item {
        min-height: 80px;
      }

      .booking-banner {
        align-items: flex-start;
        flex-direction: column;
        gap: 0.65rem;
        padding: 1rem;
      }

      .booking-paw {
        width: auto;
        min-width: 0;
        height: auto;
        padding: 0;
        border-right: 0;
      }

      .booking-paw svg {
        width: 3.4rem;
        height: 3.4rem;
      }

      .booking-button {
        width: 100%;
      }
    }

    @media (max-width: 390px) {
      .offers-grid {
        grid-template-columns: 1fr;
      }

      .offer-item,
      .offer-item:nth-child(-n+6),
      .offer-item:nth-child(n+5) {
        border-right: 0;
        border-bottom: 1px solid var(--boarding-sand);
      }

      .offer-item:last-child {
        border-bottom: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .room-card,
      .booking-button {
        transition: none;
      }

      .room-card:hover,
      .booking-button:hover {
        transform: none;
      }
    }
  </style>
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="boarding-main">
    <!-- The hero uses decorative paw prints to introduce the boarding rooms. -->
    <header class="boarding-hero">
      <div class="boarding-title-row">
        <svg class="hero-spark" viewBox="0 0 24 40" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" aria-hidden="true">
          <path d="M5 8 2 4M10 19 3 16M14 31 7 30"></path>
        </svg>
        <svg class="hero-paw" viewBox="0 0 64 64" fill="currentColor" aria-hidden="true">
          <ellipse cx="17" cy="19" rx="7" ry="10" transform="rotate(-28 17 19)"></ellipse>
          <ellipse cx="32" cy="13" rx="7" ry="10"></ellipse>
          <ellipse cx="47" cy="19" rx="7" ry="10" transform="rotate(28 47 19)"></ellipse>
          <ellipse cx="53" cy="34" rx="6" ry="8" transform="rotate(55 53 34)"></ellipse>
          <path d="M31.8 27c-8.5 0-19.8 12.1-19.8 21.3 0 7.1 6.4 9.3 12.8 6.6 4.1-1.7 9.1-1.7 13.2 0 6.4 2.7 12.8.5 12.8-6.6C50.8 39.1 40.3 27 31.8 27Z"></path>
        </svg>
        <svg class="hero-spark" viewBox="0 0 24 40" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" aria-hidden="true">
          <path d="m19 8 3-4M14 19l7-3M10 31l7-1"></path>
        </svg>
        <h1>Our Pet Boarding Rooms</h1>
        <svg class="hero-paw" viewBox="0 0 64 64" fill="currentColor" aria-hidden="true">
          <ellipse cx="17" cy="19" rx="7" ry="10" transform="rotate(-28 17 19)"></ellipse>
          <ellipse cx="32" cy="13" rx="7" ry="10"></ellipse>
          <ellipse cx="47" cy="19" rx="7" ry="10" transform="rotate(28 47 19)"></ellipse>
          <ellipse cx="53" cy="34" rx="6" ry="8" transform="rotate(55 53 34)"></ellipse>
          <path d="M31.8 27c-8.5 0-19.8 12.1-19.8 21.3 0 7.1 6.4 9.3 12.8 6.6 4.1-1.7 9.1-1.7 13.2 0 6.4 2.7 12.8.5 12.8-6.6C50.8 39.1 40.3 27 31.8 27Z"></path>
        </svg>
        <svg class="hero-spark" viewBox="0 0 24 40" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" aria-hidden="true">
          <path d="m19 8 3-4M14 19l7-3M10 31l7-1"></path>
        </svg>
      </div>
      <p class="boarding-subtitle">A cosy home away from home for your fur babies.</p>
      <p class="boarding-intro">Enjoy your holidays with peace of mind while we take care of your beloved companions.</p>
    </header>

    <!-- Both room cards reuse the same supplied den photo and present their room-specific details. -->
    <section class="row g-4 room-grid" aria-label="Pet boarding rooms">
      <div class="col-12 col-lg-6">
        <article class="room-card">
          <div class="room-photo">
            <img src="/images/pet-boarding-den.png" alt="Wooden pet boarding den interior">
          </div>
          <div class="room-details">
            <h2>Deluxe Den</h2>
            <p class="room-dimension">1.5m x 1.5m</p>
            <p class="room-area">~25 sqft</p>
            <hr class="room-divider">
            <p class="room-suitable">Suitable for:</p>
            <p class="room-size">Small-Medium size</p>
            <div class="room-price"><strong>S$88.00</strong><span>per night</span></div>
          </div>
        </article>
      </div>
      <div class="col-12 col-lg-6">
        <article class="room-card">
          <div class="room-photo">
            <img src="/images/pet-boarding-den.png" alt="Wooden pet boarding den interior">
          </div>
          <div class="room-details">
            <h2>Premier Den</h2>
            <p class="room-dimension">1.8m x 1.5m</p>
            <p class="room-area">~30 sqft</p>
            <hr class="room-divider">
            <p class="room-suitable">Suitable for:</p>
            <p class="room-size">Medium-Large size</p>
            <div class="room-price"><strong>S$108.00</strong><span>per night</span></div>
          </div>
        </article>
      </div>
    </section>

    <!-- The eight inline illustrations keep the offer grid dependency-free and responsive. -->
    <section class="offers-panel" aria-labelledby="offers-heading">
      <div class="offers-heading-row">
        <h2 class="offers-heading" id="offers-heading">What we offer.</h2>
      </div>
      <div class="offers-grid">
        <article class="offer-item">
          <h3>Social Interaction</h3>
          <span class="offer-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none">
              <circle cx="27" cy="11" r="5" fill="#E9A18B"></circle>
              <path d="M27 17v12m-7-8 7-4 7 4m-7 8-7 9m7-9 8 8" stroke="#79502E" stroke-width="3" stroke-linecap="round"></path>
              <path d="M8 32c3-4 9-4 12 0l3 4H6l2-4Z" fill="#F8E7A2" stroke="#C78132" stroke-width="2"></path>
              <circle cx="9" cy="27" r="2" fill="#C78132"></circle><circle cx="15" cy="25" r="2" fill="#C78132"></circle><circle cx="21" cy="27" r="2" fill="#C78132"></circle>
            </svg>
          </span>
        </article>
        <article class="offer-item">
          <h3>Clean Environment</h3>
          <span class="offer-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none">
              <path d="M37 7C21 9 11 18 13 32c11 2 22-8 24-25Z" fill="#A6C95F"></path>
              <path d="M12 12c4 8 9 16 19 25" stroke="#6B9E39" stroke-width="2.5" stroke-linecap="round"></path>
              <path d="m22 22 1-7m4 13 6-4m-12 0-6-4" stroke="#E8F0C9" stroke-width="2" stroke-linecap="round"></path>
            </svg>
          </span>
        </article>
        <article class="offer-item">
          <h3>24/7 Supervision</h3>
          <span class="offer-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" stroke="#2464A8" stroke-width="2.4" stroke-linejoin="round">
              <path d="m7 13 25 7-3 7-25-7z" fill="#D9E7F5"></path>
              <path d="m13 25-2 10 5 1 5-9m4 1-1 9 5 1 3-12m-3-7 7-7 4 2-8 9"></path>
              <path d="m34 11 7 2-2 4-7-2"></path>
            </svg>
          </span>
        </article>
        <article class="offer-item">
          <h3>Photo Updates</h3>
          <span class="offer-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" stroke="#478353" stroke-width="2">
              <path d="M11 8h26v29H11z" fill="#F8F5EC"></path>
              <path d="M7 12v29h26M16 13h17v20H16z"></path>
              <path d="m24.5 27-4-3.7a2.6 2.6 0 0 1 3.7-3.7l.3.4.3-.4a2.6 2.6 0 0 1 3.7 3.7L24.5 27Z" fill="#DF8266" stroke="#C85D49"></path>
            </svg>
          </span>
        </article>
        <article class="offer-item">
          <h3>Personalized Care</h3>
          <span class="offer-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none">
              <path d="M9 29c2-6 7-9 15-9s13 3 15 9l-3 9H12l-3-9Z" fill="#FFF" stroke="#6D665E" stroke-width="2"></path>
              <path d="M16 21c1-5 4-8 8-8s7 3 8 8" stroke="#79502E" stroke-width="2"></path>
              <path d="M20 30c-2-2-5 1-1 4l4 3 4-3c4-3 1-6-1-4l-3 2-3-2Z" fill="#F8E7A2" stroke="#79502E" stroke-width="1.5"></path>
              <circle cx="16" cy="27" r="1.5" fill="#66513D"></circle><circle cx="32" cy="27" r="1.5" fill="#66513D"></circle>
            </svg>
          </span>
        </article>
        <article class="offer-item">
          <h3>Health Monitoring</h3>
          <span class="offer-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" stroke="#346BB5" stroke-width="2.2" stroke-linejoin="round">
              <path d="m5 22 19-16 19 16" fill="#E8EFFB"></path>
              <path d="M10 20v22h28V20M20 42V28h8v14"></path>
              <path d="M23 15v9m-4.5-4.5h9" stroke="#D56B51" stroke-width="3" stroke-linecap="round"></path>
            </svg>
          </span>
        </article>
        <article class="offer-item">
          <h3>Daily Exercise</h3>
          <span class="offer-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="22" cy="10" r="3.5" fill="#E8AA3E"></circle>
              <path d="m20 16 7 4 5-4m-5 4-4 8m4-8 5 8m-11-9-5 6" stroke="#79502E" stroke-width="2.5"></path>
              <path d="M29 31c3-4 9-4 12 0l2 4H28l1-4Z" fill="#F8E7A2" stroke="#C78132" stroke-width="2"></path>
              <path d="m32 30 1-3m4 3 1-3" stroke="#C78132" stroke-width="2"></path>
              <path d="m11 10 1-3m6 3 1-3m20-1 1-2" stroke="#E3A54C" stroke-width="2"></path>
            </svg>
          </span>
        </article>
        <article class="offer-item">
          <h3>Soothing Music</h3>
          <span class="offer-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" stroke="#8E4BC4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 30V13l23-5v21"></path>
              <path d="M11 18 34 13"></path>
              <ellipse cx="7" cy="32" rx="4" ry="3" fill="#E8D5F5"></ellipse>
              <ellipse cx="30" cy="29" rx="4" ry="3" fill="#E8D5F5"></ellipse>
              <path d="m20 24 2-2 2 2 2 2-2 2-2 2-2-2-2-2 2-2Z"></path>
            </svg>
          </span>
        </article>
      </div>
    </section>

    <!-- The booking call-to-action opens the authenticated boarding reservation form. -->
    <section class="booking-banner" aria-labelledby="booking-heading">
      <div class="booking-paw" aria-hidden="true">
        <svg viewBox="0 0 64 64" fill="currentColor">
          <ellipse cx="17" cy="19" rx="7" ry="10" transform="rotate(-28 17 19)"></ellipse>
          <ellipse cx="32" cy="13" rx="7" ry="10"></ellipse>
          <ellipse cx="47" cy="19" rx="7" ry="10" transform="rotate(28 47 19)"></ellipse>
          <ellipse cx="53" cy="34" rx="6" ry="8" transform="rotate(55 53 34)"></ellipse>
          <path d="M31.8 27c-8.5 0-19.8 12.1-19.8 21.3 0 7.1 6.4 9.3 12.8 6.6 4.1-1.7 9.1-1.7 13.2 0 6.4 2.7 12.8.5 12.8-6.6C50.8 39.1 40.3 27 31.8 27Z"></path>
        </svg>
      </div>
      <div class="booking-copy">
        <h2 id="booking-heading">Make a Booking for Your Fur Babies Now!</h2>
        <p>Give your pets a comfortable and relaxing stay while you're away. Choose their room and reserve their stay with us!</p>
      </div>
      <a class="booking-button" href="/boarding/book">
        Book Your Pet's Stay <span aria-hidden="true">&rarr;</span>
      </a>
    </section>
  </main>
</body>
</html>
