<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Booking History</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    /* FurryTales palette overrides Bootstrap's default white, black, and primary colors. */
    :root {
      --booking-yellow: #F8E7A2;
      --booking-beige: #F7F1E5;
      --booking-sand: #E8D5B7;
      --booking-brown: #79502E;
      --booking-dark: #49321F;
    }

    body {
      min-height: 100vh;
      background: var(--booking-beige);
      color: var(--booking-dark);
      font-family: "Trebuchet MS", Arial, sans-serif;
    }

    main h1 {
      color: var(--booking-dark);
      font-weight: 800;
    }

    main .table-responsive {
      overflow-x: auto;
      border: 1px solid var(--booking-sand);
      border-radius: 1rem;
      background: #fff;
      box-shadow: 0 0.5rem 1.4rem rgb(73 50 31 / 7%);
    }

    main .table {
      --bs-table-color: var(--booking-dark);
      --bs-table-bg: #fff;
      --bs-table-border-color: var(--booking-sand);
      --bs-table-striped-bg: var(--booking-beige);
      --bs-table-striped-color: var(--booking-dark);
      --bs-table-hover-bg: var(--booking-yellow);
      --bs-table-hover-color: var(--booking-dark);
      margin-bottom: 0;
    }

    main .table thead.table-dark {
      --bs-table-bg: var(--booking-brown);
      --bs-table-color: #fff;
      --bs-table-border-color: var(--booking-brown);
    }

    main .table thead.table-dark th {
      background: var(--booking-brown);
      color: #fff;
      white-space: nowrap;
    }

    main .btn-primary {
      border-color: var(--booking-brown);
      background: var(--booking-brown);
      color: #fff;
    }

    main .btn-primary:hover,
    main .btn-primary:focus-visible {
      border-color: var(--booking-dark);
      background: var(--booking-dark);
      color: #fff;
    }

    main .text-bg-primary {
      background: var(--booking-brown) !important;
      color: #fff !important;
    }

    main .text-bg-warning {
      background: var(--booking-yellow) !important;
      color: var(--booking-dark) !important;
    }

    main .text-bg-secondary {
      background: var(--booking-sand) !important;
      color: var(--booking-dark) !important;
    }

    main .alert-success,
    main .alert-danger,
    main .alert-info {
      border-color: var(--booking-sand);
      background: #fff;
      color: var(--booking-dark);
    }

    main .alert-success {
      background: var(--booking-yellow);
    }

    main .alert-info {
      background: var(--booking-beige);
    }

    main .text-secondary {
      color: var(--booking-brown) !important;
    }

    .booking-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      min-width: 150px;
    }

    .booking-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 40px;
      padding: 0.45rem 0.85rem;
      border: 0;
      border-radius: 0.7rem;
      color: #fff;
      cursor: pointer;
      font-weight: 700;
      text-decoration: none;
      transition: background-color 150ms ease, transform 150ms ease;
    }

    .booking-actions form {
      margin: 0;
    }

    .booking-action-edit {
      background: #37834a;
    }

    .booking-action-edit:hover,
    .booking-action-edit:focus-visible {
      background: #28663a;
      color: #fff;
      transform: translateY(-1px);
    }

    .booking-action-delete {
      background: #b8423c;
    }

    .booking-action-delete:hover,
    .booking-action-delete:focus-visible {
      background: #91332f;
      color: #fff;
      transform: translateY(-1px);
    }

    @media (max-width: 575.98px) {
      .booking-actions {
        min-width: 0;
        flex-direction: column;
      }

      .booking-action {
        width: 100%;
      }

      .booking-actions form {
        width: 100%;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .booking-action {
        transition: none;
      }

      .booking-action:hover {
        transform: none;
      }
    }
  </style>
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
      <h1 class="h2 mb-0">Booking History</h1>
      <a href="/services" class="btn btn-primary">Book a Service</a>
    </div>

    <% if (messages && messages.length) { %>
      <% for (let i = 0; i < messages.length; i++) { %>
        <div class="alert alert-success" role="status"><%= messages[i] %></div>
      <% } %>
    <% } %>
    <% if (errors && errors.length) { %>
      <% for (let i = 0; i < errors.length; i++) { %>
        <div class="alert alert-danger" role="alert"><%= errors[i] %></div>
      <% } %>
    <% } %>

    <% if (!bookings.length) { %>
      <div class="alert alert-info">You have no bookings yet.</div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
          <thead class="table-dark">
            <tr>
              <th scope="col">Booking Reference</th>
              <th scope="col">Type</th>
              <th scope="col">Date / Stay</th>
              <th scope="col">Pet</th>
              <th scope="col">Service / Room</th>
              <th scope="col">Check-in / Pick-up</th>
              <th scope="col">Nights</th>
              <th scope="col">Rate</th>
              <th scope="col">Price</th>
              <th scope="col">Booking Status</th>
              <th scope="col">Payment Status</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% for (let i = 0; i < bookings.length; i++) { %>
              <tr>
                <td><%= bookings[i].booking_reference || bookings[i].booking_id %></td>
                <td>
                  <% if (bookings[i].booking_type === 'Pet Boarding') { %>
                    <span class="badge text-bg-warning">Pet Boarding</span>
                  <% } else { %>
                    <span class="badge text-bg-primary">Pet Service</span>
                  <% } %>
                </td>
                <td>
                  <% if (bookings[i].booking_type === 'Pet Boarding') { %>
                    <div><strong>In:</strong> <%= bookings[i].check_in_date %></div>
                    <div><strong>Out:</strong> <%= bookings[i].pick_up_date %></div>
                  <% } else { %>
                    <%= bookings[i].booking_date %>
                  <% } %>
                </td>
                <td><%= bookings[i].pet_name %></td>
                <td><%= bookings[i].booking_type === 'Pet Boarding' ? bookings[i].room_type : bookings[i].service_name %></td>
                <td>
                  <% if (bookings[i].booking_type === 'Pet Boarding') { %>
                    <div><strong>In:</strong> <%= bookings[i].check_in_time %></div>
                    <div><strong>Out:</strong> <%= bookings[i].pick_up_time %></div>
                  <% } else { %>
                    <span class="text-secondary">-</span>
                  <% } %>
                </td>
                <td><%= bookings[i].booking_type === 'Pet Boarding' ? bookings[i].number_of_nights : '-' %></td>
                <td>
                  <% if (bookings[i].booking_type === 'Pet Boarding') { %>
                    S$<%= Number(bookings[i].price_per_night).toFixed(2) %> / night
                  <% } else { %>
                    <span class="text-secondary">-</span>
                  <% } %>
                </td>
                <td>
                  <% if (bookings[i].booking_type === 'Pet Boarding') { %>
                    S$<%= Number(bookings[i].total_price).toFixed(2) %>
                  <% } else { %>
                    S$<%= Number(bookings[i].booked_price).toFixed(2) %>
                  <% } %>
                </td>
                <td><span class="badge text-bg-secondary"><%= bookings[i].booking_status %></span></td>
                <td>
                  <% if (bookings[i].payment_status) { %>
                    <span class="badge text-bg-secondary"><%= bookings[i].payment_status %></span>
                  <% } else { %>
                    <span class="text-secondary">No payment record</span>
                  <% } %>
                </td>
                <td>
                  <% const bookingTypePath = bookings[i].booking_type === 'Pet Boarding' ? 'boarding' : 'service'; %>
                  <div class="booking-actions">
                    <a class="booking-action booking-action-edit"
                      href="/bookings/<%= bookingTypePath %>/<%= bookings[i].booking_id %>/edit"
                      aria-label="Edit booking <%= bookings[i].booking_reference || bookings[i].booking_id %>">Edit</a>
                    <form action="/bookings/<%= bookingTypePath %>/<%= bookings[i].booking_id %>/delete"
                      method="POST" onsubmit="return confirm('Delete this booking? This action cannot be undone.');">
                      <button class="booking-action booking-action-delete" type="submit"
                        aria-label="Delete booking <%= bookings[i].booking_reference || bookings[i].booking_id %>">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <p class="text-secondary">Payments are pending. No payment has been processed by this app.</p>
    <% } %>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>