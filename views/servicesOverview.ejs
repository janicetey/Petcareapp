<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Our Services | FurryTales</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <%- include('partials/dashboardServiceCardsStyles') %>
  <style>
    /* The overview adds a centered introduction while retaining the shared dashboard cards. */
    body {
      min-height: 100vh;
      background: var(--light-beige);
      color: var(--dark-brown);
      font-family: "Trebuchet MS", Arial, sans-serif;
    }

    .services-overview-heading {
      margin: 0 0 0.65rem;
      color: var(--dark-brown);
      font-size: clamp(2rem, 4vw, 2.6rem);
      font-weight: 800;
      text-align: center;
    }

    .services-overview-subtitle {
      margin: 0 0 2.4rem;
      color: var(--dark-brown);
      font-size: 1.1rem;
      text-align: center;
    }
  </style>
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container py-5">
    <header>
      <h1 class="services-overview-heading">Our Services</h1>
      <p class="services-overview-subtitle">Choose a service for your furry companion.</p>
    </header>
    <div class="row g-4">
      <%- include('partials/dashboardServiceCards') %>
    </div>
  </main>
</body>
</html>
