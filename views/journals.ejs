<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pet Journals</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    /* FurryTales palette keeps journal tables, pet details, and controls warm and consistent. */
    :root {
      --journal-yellow: #F8E7A2;
      --journal-beige: #F7F1E5;
      --journal-sand: #E8D5B7;
      --journal-brown: #79502E;
      --journal-dark: #49321F;
    }

    body {
      min-height: 100vh;
      background: var(--journal-beige);
      color: var(--journal-dark);
      font-family: "Trebuchet MS", Arial, sans-serif;
    }

    .journal-content h2,
    .journal-content .col-form-label {
      color: var(--journal-dark);
      font-weight: 800;
    }

    .journal-content .form-control,
    .journal-content .form-select {
      border-color: var(--journal-sand);
      background-color: #fff;
      color: var(--journal-dark);
    }

    .journal-content .form-control:focus,
    .journal-content .form-select:focus {
      border-color: var(--journal-brown);
      box-shadow: 0 0 0 0.2rem rgb(121 80 46 / 16%);
    }

    .journal-content .card {
      overflow: hidden;
      border-color: var(--journal-sand);
      border-radius: 1rem;
      background: #fff;
      box-shadow: 0 0.5rem 1.4rem rgb(73 50 31 / 7%);
    }

    .journal-content .card-header {
      background: var(--journal-brown) !important;
      color: #fff !important;
    }

    .journal-content .table {
      --bs-table-color: var(--journal-dark);
      --bs-table-bg: #fff;
      --bs-table-border-color: var(--journal-sand);
      --bs-table-striped-bg: var(--journal-beige);
      --bs-table-striped-color: var(--journal-dark);
      --bs-table-hover-bg: var(--journal-yellow);
      --bs-table-hover-color: var(--journal-dark);
    }

    .journal-content .table thead.table-dark {
      --bs-table-bg: var(--journal-brown);
      --bs-table-color: #fff;
      --bs-table-border-color: var(--journal-brown);
    }

    .journal-content .table thead.table-dark th {
      background: var(--journal-brown);
      color: #fff;
    }

    .journal-content .btn-outline-primary,
    .journal-content .btn-outline-secondary {
      border-color: var(--journal-brown);
      color: var(--journal-brown);
    }

    .journal-content .btn-outline-primary:hover,
    .journal-content .btn-outline-secondary:hover,
    .journal-content .btn-outline-primary:focus-visible,
    .journal-content .btn-outline-secondary:focus-visible {
      border-color: var(--journal-sand);
      background: var(--journal-sand);
      color: var(--journal-dark);
    }

    .journal-content .btn-success {
      border-color: var(--journal-brown);
      background: var(--journal-brown);
      color: #fff;
    }

    .journal-content .btn-success:hover,
    .journal-content .btn-success:focus-visible {
      border-color: var(--journal-dark);
      background: var(--journal-dark);
      color: #fff;
    }

    .journal-content .btn-warning {
      border-color: var(--journal-yellow);
      background: var(--journal-yellow);
      color: var(--journal-dark);
    }

    .journal-content .btn-warning:hover,
    .journal-content .btn-warning:focus-visible {
      border-color: var(--journal-sand);
      background: var(--journal-sand);
      color: var(--journal-dark);
    }

    .journal-content .btn-danger {
      border-color: var(--journal-sand);
      background: var(--journal-sand);
      color: var(--journal-dark);
    }

    .journal-content .btn-danger:hover,
    .journal-content .btn-danger:focus-visible {
      border-color: var(--journal-brown);
      background: var(--journal-brown);
      color: #fff;
    }

  </style>
</head>
<body>

  <%- include ('partials/navbar') %>

  <main class="container journal-content mt-5">
    <h2 class="mb-4">Pet Care Journals</h2>

    <form action="/journals/search" method="GET" class="mb-3 d-flex">
        <input type="text" name="q" class="form-control me-2" placeholder="Search activity or notes..." required>
        <% if (selectedPetId) { %>
            <input type="hidden" name="petId" value="<%= selectedPetId %>">
        <% } %>
        <button type="submit" class="btn btn-outline-primary me-2">Search</button>
        <% let resetUrl = '/journals'; %>
        <% if (selectedPetId) { %>
        <% resetUrl += '?petId=' + selectedPetId; %>
        <% } %>
        <a href="<%= resetUrl %>" class="btn btn-outline-secondary">Reset</a>
    </form>

    <% if (pets && pets.length > 0) { %>
        <form method="GET" action="/journals" class="mb-3">
            <div class="row g-2 align-items-center">
                <div class="col-auto">
                <label for="petId" class="col-form-label">Select Pet:</label>
                </div>
                <div class="col-auto">
                <select name="petId" id="petId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- All Pets --</option>
                    <% for (let i = 0; i < pets.length; i++) { %>
                    <% if (selectedPetId && selectedPetId == pets[i].id.toString()) { %>
                        <option value="<%= pets[i].id %>" selected><%= pets[i].name %></option>
                    <% } else { %>
                        <option value="<%= pets[i].id %>"><%= pets[i].name %></option>
                    <% } %>
                    <% } %>
                </select>
                </div>
            </div>
        </form>
    <% } %>



    <% if (pet && pet.name) { %>
    <div class="card mb-4">
        <div class="card-header bg-dark text-white text-center">
            <strong>Pet Info</strong>
        </div>
        <div class="card-body d-flex flex-column align-items-center">
            <img src="/images/<%= pet.image %>" 
                class="img-thumbnail mb-3" 
                alt="<%= pet.image %>" 
                style="width: 200px; height: 200px; object-fit: cover;">

            <p><strong>Name:</strong> <%= pet.name %></p>
            <p><strong>Type:</strong> <%= pet.species %></p>
            <p><strong>Breed:</strong> <%= pet.breed %></p>
            <p><strong>Age:</strong> <%= pet.age %> years</p>
        </div>
        </div>

    <% } %>

    <a href="/journals/new" class="btn btn-success mb-3">+ Add New Entry</a>
    <a href="/pets/new" class="btn btn-outline-secondary mb-3">+ Add New Pet</a>


    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr>
          <th>#</th>
          <th>Date</th>
          <th>Activity</th>
          <th>Notes</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (journals.length === 0) { %>
          <tr>
            <td colspan="6" class="text-center">No journal entries found.</td>
          </tr>
        <% } else { %>
          <% for (let i = 0; i < journals.length; i++) { %>
            <tr>
              <td><%= i + 1 %></td>
              <td>
                <% if (journals[i].entry_date) { %>
                    <%= journals[i].entry_date.toISOString().split('T')[0] %>
                <% } else { %>
                    N/A
                <% } %>
              </td>
              <td><%= journals[i].activity %></td>
              <td><%= journals[i].notes %></td>
              <td>
                <a href="/journals/edit/<%= journals[i].id %>" class="btn btn-sm btn-warning">Edit</a>
                <a href="/journals/delete/<%= journals[i].id %>" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this entry?');">Delete</a>
              </td>
            </tr>
          <% } %>
        <% } %>
      </tbody>
    </table>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
